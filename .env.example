# JobsSpot backend API base URL. Include the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Keep enough headroom for a sleeping free Render service to wake up.
NEXT_PUBLIC_API_TIMEOUT_MS=75000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Canonical public JobsSpot website origin, used for metadata/SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
